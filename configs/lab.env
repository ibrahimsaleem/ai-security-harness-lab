# Source this before any lab command: keeps every interpreter, tool and cache inside the lab.
LAB=/Users/ibrahim/Developer/ai-security-harness-lab
export UV_PYTHON_INSTALL_DIR=$LAB/environments/python
export UV_TOOL_DIR=$LAB/environments/uv-tools
export UV_TOOL_BIN_DIR=$LAB/environments/bin
export UV_CACHE_DIR=$LAB/environments/.uv-cache
export npm_config_cache=$LAB/environments/.npm-cache
export PATH=$LAB/environments/bin:$PATH
# Telemetry off for tools that support it
export SEMGREP_SEND_METRICS=off
export DO_NOT_TRACK=1
export PROMPTFOO_DISABLE_TELEMETRY=1
export PROMPTFOO_DISABLE_UPDATE=1
export UV_PYTHON_BIN_DIR=$LAB/environments/bin
